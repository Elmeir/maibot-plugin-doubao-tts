{
  "manifest_version": 2,
  "version": "1.4.0",
  "id": "github.ZhaoCang-QWQ.doubao-tts",
  "name": "豆包语音TTS（新版控制台）",
  "description": "麦麦语音回复：调用火山引擎豆包语音合成大模型把文字变语音。内置官方预置音色库，也支持复刻音色；若 /说 后收到的是文字而非语音，通常是音色与资源不匹配（复刻音色须配 seed-icl-2.0，预置音色配 seed-tts-2.0）。新版 X-Api-Key 鉴权，无需旧版 App ID。",
  "author": {
    "name": "昭沧QWQ",
    "url": "https://github.com/ZhaoCang-QWQ"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ZhaoCang-QWQ/doubao-tts",
    "homepage": "https://github.com/ZhaoCang-QWQ/doubao-tts"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎙️"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}