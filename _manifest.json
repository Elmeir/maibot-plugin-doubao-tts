{
  "manifest_version": 2,
  "version": "1.6.2",
  "id": "github.elmeir.doubao-tts",
  "name": "豆包·MiMo 语音TTS",
  "description": "麦麦语音回复：双引擎可切换——火山豆包语音（内置官方预置音色库，也支持复刻音色）或小米 MiMo 音色复刻（mimo-v2.5-tts-voiceclone，把 wav/mp3 音源放进插件 src/ 即可开口）。配置主页只放开关与下拉，豆包/MiMo 各一个页签改连接；新版 X-Api-Key / Bearer 鉴权。",
  "author": {
    "name": "Elmeir",
    "url": "https://github.com/Elmeir"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Elmeir/maibot-plugin-doubao-tts",
    "homepage": "https://github.com/Elmeir/maibot-plugin-doubao-tts",
    "documentation": "https://github.com/Elmeir/maibot-plugin-doubao-tts#readme",
    "issues": "https://github.com/Elmeir/maibot-plugin-doubao-tts/issues"
  },
  "host_application": {
    "min_version": "1.2.4",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom",
    "maisaka.context.append"
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎙️"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}